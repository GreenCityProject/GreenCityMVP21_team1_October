<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="update-event-days-add-location-fk" author="DmytroKaplun">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="event_days" columnName="location_id"/>
            </not>
        </preConditions>

        <addColumn tableName="event_days">
            <column name="location_id" type="BIGINT">
                <constraints nullable="true"/>
            </column>
        </addColumn>

        <addForeignKeyConstraint baseTableName="event_days" baseColumnNames="location_id"
                                 referencedTableName="locations" referencedColumnNames="id"
                                 constraintName="fk_event_days_location"/>
    </changeSet>
</databaseChangeLog>