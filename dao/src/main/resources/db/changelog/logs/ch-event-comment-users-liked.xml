<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="1732400957753-1" author="Andrii-Danylenko">
        <createTable tableName="event_comments_users_liked">
            <column name="event_comment_id" type="BIGINT">
                <constraints nullable="false" />
            </column>
            <column name="users_liked_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint baseTableName="event_comments_users_liked"
                                 baseColumnNames="event_comment_id"
                                 constraintName="fk_event_comments_users_like_comment"
                                 referencedTableName="event_comments"
                                 referencedColumnNames="id"/>
        <addForeignKeyConstraint baseTableName="event_comments_users_liked"
                                 baseColumnNames="users_liked_id"
                                 constraintName="fk_event_comments_users_like_user"
                                 referencedTableName="users"
                                 referencedColumnNames="id"/>
    </changeSet>
</databaseChangeLog>