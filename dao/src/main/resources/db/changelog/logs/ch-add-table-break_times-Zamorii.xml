<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.15.xsd">

    <changeSet id="create-table-break_times" author="Serhii Zamorii">
        <createTable tableName="break_times">
            <column name="id" type="bigserial">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="end_time" type="time(6)">
                <constraints nullable="false"/>
            </column>
            <column name="start_time" type="time(6)">
                <constraints nullable="false"/>
            </column>
            <column name="open_hours_id" type="int8">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint tableName="break_times" columnNames="open_hours_id"
                             constraintName="uk_knbj9macv2cyehd68yoe0ba2v"/>
        <addForeignKeyConstraint baseTableName="break_times" baseColumnNames="open_hours_id"
                                 constraintName="fksp97nmg2u91u1b7nm1viw8dww" referencedTableName="open_hours_list"
                                 referencedColumnNames="id" onDelete="CASCADE"/>
    </changeSet>
</databaseChangeLog>