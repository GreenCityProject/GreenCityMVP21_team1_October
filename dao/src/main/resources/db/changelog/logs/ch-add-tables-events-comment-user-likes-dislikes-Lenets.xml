<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.4.xsd">

    <changeSet id="17331486582111-4" author="Andrii-Danylenko">
        <createTable tableName="event_comments_users_liked">
            <column name="event_comment_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="users_liked_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint baseColumnNames="event_comment_id" baseTableName="event_comments_users_liked"
                                 constraintName="fk_events_comment_users_likes_events_comment"
                                 onDelete="RESTRICT"
                                 onUpdate="RESTRICT"
                                 referencedColumnNames="id"
                                 referencedTableName="event_comments"/>
        <addForeignKeyConstraint baseColumnNames="users_liked_id" baseTableName="event_comments_users_liked"
                                 constraintName="fk_events_comment_users_likes_users"
                                 onDelete="RESTRICT"
                                 onUpdate="RESTRICT"
                                 referencedColumnNames="id"
                                 referencedTableName="users"/>

        <addPrimaryKey
                tableName="event_comments_users_liked"
                columnNames="users_liked_id, event_comment_id"/>
    </changeSet>

</databaseChangeLog>